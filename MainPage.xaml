<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Viola_Eliana_ReadingTracker.MainPage"
             Title="">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Library"
                     Clicked="Library_Clicked"/>
    </ContentPage.ToolbarItems>

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="10">

        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="10">
            <Entry x:Name="SearchEntry"
                   Placeholder="Search by title"
                   ReturnType="Search"
                   Completed="OnSearchClicked"/>
            <Button Grid.Column="1"
                    Text="Search"
                    Clicked="OnSearchClicked"/>
        </Grid>

        <VerticalStackLayout Grid.Row="1"
                             Spacing="4">
            <ActivityIndicator x:Name="Spinner"
                               IsRunning="False"
                               IsVisible="False"/>
            <Label x:Name="MessageLabel"
                   Text=""
                   TextColor="Red"
                   IsVisible="False"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <CollectionView Grid.Row="2"
                        x:Name="ResultsView"
                        SelectionMode="Single"
                        SelectionChanged="OnResultSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,5"
                          ColumnDefinitions="80,*"
                          ColumnSpacing="10">
                        <Image Source="{Binding CoverUrl}"
                               WidthRequest="80"
                               HeightRequest="120"
                               Aspect="AspectFit"/>
                        <VerticalStackLayout Grid.Column="1"
                                             VerticalOptions="Center"
                                             Spacing="2">
                            <Label Text="{Binding DisplayTitle}"
                                   FontSize="Medium"
                                   FontAttributes="Bold"/>
                            <Label Text="{Binding DisplayAuthor}"/>
                            <Label Text="{Binding DisplayYear}"
                                   FontSize="Small"/>
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>




</ContentPage>
